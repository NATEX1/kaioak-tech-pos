# Copy this file to .env and fill every value. Never commit .env.
# Generate strong values, for example:
#   openssl rand -base64 32
#   openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24

# PostgreSQL / Docker Compose
POSTGRES_USER=compos
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=compos
POSTGRES_PORT=5432
# Keep the password URL-encoded if it contains special characters.
DATABASE_URL="postgresql://compos:replace-with-a-strong-database-password@localhost:5432/compos?schema=public"

# Auth.js (used from Phase 2 onward)
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Initial users created by `npm run db:seed`.
# Use different strong passwords for every account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_TECH1_EMAIL=tech1@example.com
SEED_TECH1_PASSWORD=replace-with-a-strong-technician-password
SEED_TECH2_EMAIL=tech2@example.com
SEED_TECH2_PASSWORD=replace-with-another-strong-password

# Optional: shop name for the base seed. The full profile is editable in /settings/shop.
SEED_SHOP_NAME=KAIOAK TECH

# Optional: comma-separated trusted proxy IPs/CIDRs for x-forwarded-for validation.
# Leave empty in development. Set to your reverse proxy IP in production.
# Example: TRUSTED_PROXY_CIDRS=127.0.0.1,::1,172.16.0.0/12
TRUSTED_PROXY_CIDRS=
